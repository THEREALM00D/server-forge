{
  "name": "server-forge",
  "version": "0.0.1-alpha.13",
  "description": "Open-source desktop manager for game dedicated servers",
  "main": "./out/main/index.js",
  "author": "",
  "homepage": "https://github.com",
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write .",
    "fix:prettier": "prettier --write",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "generate:thunderstore": "swagger-typescript-api generate -p https://thunderstore.io/api/docs/?format=openapi -o src/main/games/valheim -n thunderstore-api.ts --no-client"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-form": "^1.33.5",
    "archiver": "^8.0.0",
    "date-fns": "^4.4.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "node-pty": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "systeminformation": "^5.33.10",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "44.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "swagger-typescript-api": "^13.12.6",
    "typescript": "^6.0.2",
    "vite": "^5.3.1"
  }
}
